{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{file:context7.key}"
        }
      },
      "playwright": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--headless"
        ]
      }
    }
  }
}
