<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <PropertyGroup>
    <NativeFotos>$(MSBuildThisFileDirectory)../../.native-fotos/3.2.1</NativeFotos>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(NativeFotos)/opt/libjpeg-turbo/lib64/libturbojpeg.so.0.5.0" Link="libturbojpeg.so.0"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NativeFotos)/usr/share/doc/libjpeg-turbo-official-3.2.1/LICENSE.md" Link="licencas/libjpeg-turbo/LICENSE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NativeFotos)/usr/share/doc/libjpeg-turbo-official-3.2.1/README.ijg" Link="licencas/libjpeg-turbo/README.ijg"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExigirNativeFotosQualificado" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(NativeFotos)/opt/libjpeg-turbo/lib64/libturbojpeg.so.0.5.0')"
           Text="Prepare o artefato nativo oficial verificado: python3 ensaios/Fotos.Qualificacao/preparar-libjpeg.py (em app/backend)." />
  </Target>
</Project>
